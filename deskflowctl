#!/bin/bash
# Headless Deskflow setup for the Omarchy widget, so the Deskflow app never has
# to be opened. Everything here edits the same files the app would write:
#
#   ~/.config/Deskflow/Deskflow.conf          app settings (QSettings INI)
#   ~/.config/Deskflow/deskflow-server.conf   server screen layout
#   ~/.config/Deskflow/tls/deskflow.pem       this machine's TLS key + certificate
#   ~/.config/Deskflow/tls/trusted-servers    fingerprints a client accepts
#   ~/.config/Deskflow/tls/trusted-clients    fingerprints a server accepts
#   ~/.config/Deskflow/omarchy-screens        widget-owned "name direction" list
#                                             the layout is generated from

set -uo pipefail

DIR="${XDG_CONFIG_HOME:-$HOME/.config}/Deskflow"
CONF="$DIR/Deskflow.conf"
SERVER_CONF="$DIR/deskflow-server.conf"
SCREENS="$DIR/omarchy-screens"
TLS="$DIR/tls"
CERT="$TLS/deskflow.pem"
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
PLUGIN_DIR="$(cd "$(dirname "$0")" && pwd)"

die() { echo "$*" >&2; exit 1; }

ini_get() { # section key
  [[ -f $CONF ]] || return 0
  awk -F= -v s="[$1]" -v k="$2" '$0==s{f=1;next} /^\[/{f=0} f&&$1==k{sub(/^[^=]*=/,"");print;exit}' "$CONF"
}

ini_set() { # section key value
  mkdir -p "$DIR"
  touch "$CONF"
  local tmp
  tmp=$(mktemp "$CONF.XXXXXX")
  awk -v s="[$1]" -v k="$2" -v v="$3" '
    $0==s { print; insec=1; next }
    /^\[/ { if (insec && !done) { print k "=" v; done=1 } insec=0 }
    insec && index($0, k "=")==1 { if (!done) print k "=" v; done=1; next }
    { print }
    END {
      if (!done) {
        if (!insec) { if (NR) print ""; print s }
        print k "=" v
      }
    }' "$CONF" >"$tmp" && mv "$tmp" "$CONF"
}

valid_name() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,254}$ ]]; }
valid_host() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._:-]{0,254}$ ]]; }
valid_direction() { [[ $1 == above || $1 == below || $1 == left || $1 == right ]]; }

# Deskflow defaults the screen name to the cleaned-up hostname.
screen_name() {
  local name
  name=$(ini_get core computerName)
  [[ -n $name ]] || name=$(hostnamectl hostname 2>/dev/null || hostname)
  echo "$name"
}

unit_for() { echo "deskflow@$1.service"; }

ensure_unit() {
  cmp -s "$PLUGIN_DIR/deskflow@.service" "$UNIT_DIR/deskflow@.service" && return 0
  install -Dm644 "$PLUGIN_DIR/deskflow@.service" "$UNIT_DIR/deskflow@.service" && systemctl --user daemon-reload
}

# Same shape as the app's generator: an RSA key followed by a self-signed
# certificate in one PEM file.
ensure_cert() {
  [[ -s $CERT ]] && return 0
  mkdir -p "$TLS" && chmod 700 "$TLS"
  local key crt
  key=$(mktemp) crt=$(mktemp)
  openssl req -x509 -nodes -newkey rsa:2048 -days 3650 -subj "/CN=Deskflow" \
    -keyout "$key" -out "$crt" >/dev/null 2>&1 || { rm -f "$key" "$crt"; die "Could not create a TLS certificate"; }
  cat "$key" "$crt" >"$CERT" && chmod 600 "$CERT"
  rm -f "$key" "$crt"
}

own_fingerprint() {
  [[ -s $CERT ]] || return 0
  openssl x509 -in "$CERT" -noout -fingerprint -sha256 2>/dev/null | sed 's/.*=//; s/://g'
}

is_trusted() { # db HEX
  [[ -f $1 ]] && grep -qix "v2:sha256:$2" "$1"
}

trusted_db() { [[ $1 == server ]] && echo "$TLS/trusted-clients" || echo "$TLS/trusted-servers"; }

write_layout() {
  local self
  self=$(screen_name)
  mkdir -p "$DIR"
  {
    echo "# Generated by the Omarchy Deskflow widget from omarchy-screens."
    echo "section: screens"
    echo "	$self:"
    [[ -f $SCREENS ]] && while read -r name _; do echo "	$name:"; done <"$SCREENS"
    echo "end"
    echo
    echo "section: links"
    echo "	$self:"
    [[ -f $SCREENS ]] && while read -r name direction; do
      case $direction in
        above) echo "		up = $name" ;;
        below) echo "		down = $name" ;;
        left) echo "		left = $name" ;;
        right) echo "		right = $name" ;;
      esac
    done <"$SCREENS"
    [[ -f $SCREENS ]] && while read -r name direction; do
      echo "	$name:"
      case $direction in
        above) echo "		down = $self" ;;
        below) echo "		up = $self" ;;
        left) echo "		right = $self" ;;
        right) echo "		left = $self" ;;
      esac
    done <"$SCREENS"
    echo "end"
  } >"$SERVER_CONF"
}

restart_if_running() {
  local unit
  unit=$(unit_for "$1")
  systemctl --user is-active --quiet "$unit" && systemctl --user restart "$unit"
  return 0
}

status() { # mode
  local mode=$1 unit state result since logs
  unit=$(unit_for "$mode")
  command -v deskflow-core >/dev/null && echo installed=1 || echo installed=0
  state=$(systemctl --user is-active "$unit" 2>/dev/null)
  result=$(systemctl --user show -p SubState --value "$unit" 2>/dev/null)
  echo "active=$state"
  echo "substate=$result"
  echo "enabled=$(systemctl --user is-enabled "$unit" 2>/dev/null)"
  echo "host=$(ini_get client remoteHost)"
  echo "screen=$(screen_name)"
  echo "coremode=$(ini_get core coreMode)"
  echo "fingerprint=$(own_fingerprint)"
  [[ -f $SCREENS ]] && while read -r name direction; do echo "layout=$name $direction"; done <"$SCREENS"

  since=$(systemctl --user show -p ExecMainStartTimestamp --value --timestamp=unix "$unit" 2>/dev/null)
  [[ -n $since && $state != inactive ]] || return 0
  logs=$(journalctl --user -u "$unit" --since "$since" -o cat --no-pager 2>/dev/null | tail -n 2000)
  grep -iE 'connected|failed to' <<<"$logs" | tail -n 500 | sed 's/^/log=/'
  grep -E 'FATAL|ERROR' <<<"$logs" | tail -n 1 | sed 's/^\[[^]]*\] //; s/^/error=/'

  # A refused peer logs its fingerprint first; offer it until it is trusted.
  local peer
  peer=$(grep -oE 'peer fingerprint: [0-9A-Fa-f]{64}' <<<"$logs" | tail -n 1 | awk '{print toupper($3)}')
  [[ -n $peer ]] && ! is_trusted "$(trusted_db "$mode")" "$peer" && echo "pending=$peer"

  if [[ $mode == server ]]; then
    local unknown
    unknown=$(grep -oE 'unrecognised client name "[^"]+"' <<<"$logs" | tail -n 1 | cut -d'"' -f2)
    [[ -n $unknown ]] && ! grep -q "^$unknown " "$SCREENS" 2>/dev/null && echo "unknown=$unknown"
  fi
  return 0
}

case "${1:-}" in
  status)
    [[ ${2:-} == server ]] && status server || status client
    ;;
  start | stop | enable | disable)
    [[ ${2:-} == server || ${2:-} == client ]] || die "Unknown mode"
    ensure_unit || die "Could not install the Deskflow unit"
    if [[ $1 == start ]]; then
      # The Deskflow app runs its own core (and tray icon) that would fight
      # this unit for the connection, so it has to go before we start.
      if ! systemctl --user is-active --quiet "$(unit_for "$2")"; then
        pkill -x deskflow 2>/dev/null
        pkill -x deskflow-core 2>/dev/null
      fi
      ensure_cert
      # Only one mode runs at a time.
      systemctl --user stop "$(unit_for "$([[ $2 == server ]] && echo client || echo server)")" 2>/dev/null
      [[ $2 == server && ! -f $SERVER_CONF ]] && write_layout
      [[ $2 == client && -z $(ini_get client remoteHost) ]] && die "Enter the server address first"
    fi
    systemctl --user "$1" "$(unit_for "$2")"
    ;;
  set-mode)
    [[ ${2:-} == server || ${2:-} == client ]] || die "Unknown mode"
    systemctl --user stop "$(unit_for client)" "$(unit_for server)" 2>/dev/null
    omarchy bar set deskflow mode "$2" >/dev/null
    ;;
  set-server)
    valid_host "${2:-}" || die "That doesn't look like a server address"
    ini_set client remoteHost "$2"
    restart_if_running client
    ;;
  trust)
    [[ ${2:-} == server || ${2:-} == client ]] || die "Unknown mode"
    [[ ${3:-} =~ ^[0-9A-Fa-f]{64}$ ]] || die "Invalid fingerprint"
    db=$(trusted_db "$2")
    mkdir -p "$TLS"
    is_trusted "$db" "$3" || echo "v2:sha256:${3,,}" >>"$db"
    restart_if_running "$2"
    ;;
  add-screen)
    valid_name "${2:-}" || die "Invalid screen name"
    valid_direction "${3:-}" || die "Invalid direction"
    [[ $2 != "$(screen_name)" ]] || die "That's this machine"
    mkdir -p "$DIR"
    # One neighbour per side, and each name once.
    [[ -f $SCREENS ]] && sed -i -E "/^$2 /d; / $3\$/d" "$SCREENS"
    echo "$2 $3" >>"$SCREENS"
    write_layout
    restart_if_running server
    ;;
  remove-screen)
    valid_name "${2:-}" || die "Invalid screen name"
    [[ -f $SCREENS ]] && sed -i "/^$2 /d" "$SCREENS"
    write_layout
    restart_if_running server
    ;;
  *)
    die "Usage: deskflowctl status|start|stop|enable|disable|set-mode|set-server|trust|add-screen|remove-screen"
    ;;
esac
